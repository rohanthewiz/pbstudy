// pbstudy stylesheet — Stylus, compiled by go-styl at request time.
//
// Written in the brace/semicolon dialect (go-styl accepts both) because the
// nesting depth here is shallow and braces survive copy/paste better.
//
// Design intent: a reading surface first. Scripture gets a serif face, a
// generous measure, and the highest contrast on the page; chrome recedes.
// Dark by default — long study sessions happen at night.

// ---- palette -------------------------------------------------------------
bg          = #14161a;
bgRaised    = #1b1e24;
bgSunken    = #101216;
border      = #2a2f38;
text        = #d8dce3;
textDim     = #8b94a3;
textBright  = #f2f5f9;
accent      = #7fb3d5;   // links, verse numbers
accentWarm  = #d9a441;   // notes / annotations
danger      = #d97070;

// ---- type ----------------------------------------------------------------
uiFont      = -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
readFont    = "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
monoFont    = ui-monospace, SFMono-Regular, Menlo, monospace;

radius      = 6px;
maxWidth    = 46rem;   // ~72 characters at the reading size: a comfortable measure

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  background: bg;
  color: text;
  font-family: uiFont;
  font-size: 16px;
  line-height: 1.5;
}

a { color: accent; text-decoration: none; }
a:hover { text-decoration: underline; }

// ---- header / nav --------------------------------------------------------
.site-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
  padding: 0.6rem 1rem;
  background: bgRaised;
  border-bottom: 1px solid border;
  position: sticky;
  top: 0;
  z-index: 10;
}

.brand {
  font-weight: 600;
  font-size: 1.05rem;
  color: textBright;
  letter-spacing: 0.02em;
}
.brand:hover { text-decoration: none; color: accent; }

.site-nav {
  display: flex;
  gap: 0.9rem;
  flex-wrap: wrap;
}
.site-nav a {
  color: textDim;
  font-size: 0.92rem;
  padding: 0.15rem 0;
  border-bottom: 2px solid transparent;
}
.site-nav a:hover { color: text; text-decoration: none; }
.site-nav a.active { color: textBright; border-bottom-color: accent; }

.header-search { margin-left: auto; display: flex; gap: 0.35rem; }
.header-search input {
  width: 15rem;
  max-width: 40vw;
}

// ---- shared form controls -----------------------------------------------
input[type=text], input[type=search], select, textarea {
  background: bgSunken;
  color: text;
  border: 1px solid border;
  border-radius: radius;
  padding: 0.35rem 0.55rem;
  font-family: uiFont;
  font-size: 0.92rem;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: accent;
}

button, .btn {
  background: bgRaised;
  color: text;
  border: 1px solid border;
  border-radius: radius;
  padding: 0.35rem 0.75rem;
  font-family: uiFont;
  font-size: 0.92rem;
  cursor: pointer;
}
button:hover, .btn:hover { border-color: accent; color: textBright; text-decoration: none; }

.btn-primary { background: accent; color: bg; border-color: accent; font-weight: 600; }
.btn-primary:hover { color: bg; filter: brightness(1.1); }

.btn-danger { border-color: danger; color: danger; }
.btn-danger:hover { background: danger; color: bg; border-color: danger; }

// A button that reads as a link — used for the inline "remove" control on a
// cross-reference, where a full button would outweigh the row it sits in.
.btn-link {
  background: none;
  border: none;
  color: textDim;
  padding: 0 0.3rem;
  font-size: 1rem;
  line-height: 1;
  cursor: pointer;
}
.btn-link:hover { color: danger; }

// ---- layout --------------------------------------------------------------
main {
  max-width: 60rem;
  margin: 0 auto;
  padding: 1.25rem 1rem 4rem;
}

.page-title {
  margin: 0 0 0.25rem;
  font-size: 1.5rem;
  color: textBright;
  font-weight: 600;
}
.page-sub { margin: 0 0 1.25rem; color: textDim; font-size: 0.92rem; }

.card {
  background: bgRaised;
  border: 1px solid border;
  border-radius: radius;
  padding: 0.9rem 1.1rem;
  margin-bottom: 1rem;
}
.card h2 { margin: 0 0 0.6rem; font-size: 1.05rem; color: textBright; font-weight: 600; }

.notice {
  border-left: 3px solid accentWarm;
  background: bgRaised;
  padding: 0.7rem 1rem;
  border-radius: 0 radius radius 0;
  margin-bottom: 1rem;
  color: textDim;
}
.notice strong { color: textBright; }

.empty { color: textDim; font-style: italic; }

.error-page code {
  font-family: monoFont;
  font-size: 0.9rem;
  color: danger;
}

// ---- reader --------------------------------------------------------------
.reader-bar {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
  padding-bottom: 0.8rem;
  border-bottom: 1px solid border;
}
.reader-bar form { display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; }
.reader-bar label { color: textDim; font-size: 0.85rem; }

.chapter-nav { display: flex; gap: 0.5rem; margin-left: auto; }

.scripture {
  max-width: maxWidth;
  font-family: readFont;
  font-size: 1.16rem;
  line-height: 1.72;
  color: textBright;
}

.verse {
  display: block;
  margin: 0 0 0.55rem;
  scroll-margin-top: 4rem;   // so #v16 does not land under the sticky header
}
.verse:target {
  background: rgba(127, 179, 213, 0.12);
  border-radius: radius;
  box-shadow: 0 0 0 0.4rem rgba(127, 179, 213, 0.12);
}

.verse-num {
  font-family: uiFont;
  font-size: 0.72rem;
  font-weight: 600;
  color: accent;
  vertical-align: 0.35em;
  margin-right: 0.3rem;
  text-decoration: none;
}
.verse-num:hover { text-decoration: underline; }

// Marks a verse that has notes or cross-references attached. Deliberately in
// the warm accent rather than the link blue: the eye should be able to scan a
// chapter for "where have I been working" without confusing an annotation
// marker for a verse number.
.verse-mark {
  font-family: uiFont;
  font-size: 0.7rem;
  color: accentWarm;
  margin-left: 0.3rem;
  vertical-align: 0.35em;
  text-decoration: none;
}
.verse-mark:hover { text-decoration: none; filter: brightness(1.3); }

// ---- verse hub -----------------------------------------------------------
.verse-hero {
  font-family: readFont;
  font-size: 1.3rem;
  line-height: 1.6;
  color: textBright;
  max-width: maxWidth;
  margin-bottom: 0.4rem;
}

.translation-row {
  display: flex;
  gap: 0.8rem;
  padding: 0.6rem 0;
  border-bottom: 1px solid border;
}
.translation-row:last-child { border-bottom: none; }
.translation-tag {
  flex: 0 0 3.2rem;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: textDim;
  text-transform: uppercase;
  padding-top: 0.3rem;
}
.translation-body { font-family: readFont; font-size: 1.05rem; line-height: 1.65; }

.link-row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.5rem; }

// ---- search --------------------------------------------------------------
// The on-page search form. Wider than the header's box because this is where
// a query gets refined rather than typed in passing.
.search-form {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  margin: 0.6rem 0 1rem;
}
.search-form input[type=search] { flex: 1 1 22rem; }

// Scope tabs are links, not buttons: each one is a real, bookmarkable URL.
// Styled as a segmented control so the set reads as one choice.
.scope-tabs {
  display: flex;
  gap: 0.25rem;
  margin-bottom: 1.1rem;
  border-bottom: 1px solid border;
}
.scope-tab {
  padding: 0.3rem 0.7rem;
  font-size: 0.88rem;
  color: textDim;
  border: 1px solid transparent;
  border-bottom: none;
  border-radius: radius radius 0 0;
  margin-bottom: -1px;
}
.scope-tab:hover { color: text; text-decoration: none; }
.scope-tab.active {
  color: textBright;
  background: bgRaised;
  border-color: border;
  border-bottom-color: bgRaised;
}

// One kind of result. The heading carries its own count so a scan down the
// page answers "how much of this is scripture and how much is mine".
.result-group { margin-bottom: 1.6rem; }
.result-heading {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: textDim;
  font-weight: 600;
  margin: 0 0 0.4rem;
}
.result-count {
  font-size: 0.78rem;
  letter-spacing: 0.02em;
  text-transform: none;
  color: textDim;
  font-weight: 400;
}

// The browser default for <mark> is black on yellow, which detonates on a dark
// reading surface. Tint the background instead and keep the reading colour.
mark {
  background: rgba(217, 164, 65, 0.25);
  color: textBright;
  border-radius: 2px;
  padding: 0 0.1em;
}

// ---- book grid (dashboard) ----------------------------------------------
.book-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
  gap: 0.4rem;
  margin-bottom: 1.5rem;
}
.book-grid a {
  display: block;
  padding: 0.4rem 0.6rem;
  background: bgSunken;
  border: 1px solid border;
  border-radius: radius;
  font-size: 0.88rem;
  color: text;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.book-grid a:hover { border-color: accent; color: textBright; text-decoration: none; }

.testament-label {
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: textDim;
  margin: 1.2rem 0 0.5rem;
}

// ---- notes, tags, cross-references ---------------------------------------
// A page header that carries an action on the right (New note, Full editor).
.page-head {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 0.25rem;
}
.page-head .page-title { margin-bottom: 0; }
.page-head .btn, .page-head .link-row { margin-left: auto; }

// Chips are the compact form of a reference or a tag. They appear in four
// different views, so they carry no layout of their own beyond the row.
.chip-row {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
  margin: 0.3rem 0 0.6rem;
}
.chip-row-large { gap: 0.5rem; }

.chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.1rem 0.5rem;
  border: 1px solid border;
  border-radius: 1rem;
  font-size: 0.78rem;
  white-space: nowrap;
  background: bgSunken;
}
a.chip:hover { text-decoration: none; border-color: accent; }

.chip-ref { color: accent; }
.chip-tag { color: accentWarm; }
.chip-count {
  font-size: 0.7rem;
  color: textDim;
  border-left: 1px solid border;
  padding-left: 0.35rem;
}

// One note in a list. The rows share a card, separated by rules rather than
// by gaps, so a long list reads as one object instead of many.
.note-row {
  padding: 0.65rem 0;
  border-bottom: 1px solid border;
}
.note-row:first-child { padding-top: 0; }
.note-row:last-child { border-bottom: none; padding-bottom: 0; }

.note-title { font-weight: 600; color: textBright; font-size: 1rem; }
.note-title:hover { color: accent; }

.note-excerpt {
  margin: 0.2rem 0 0;
  color: textDim;
  font-size: 0.88rem;
  line-height: 1.5;
}

// The rendered Markdown body. Serif and a reading measure, because a note is
// prose meant to be read next to scripture, not a form field's contents.
.note-body {
  font-family: readFont;
  font-size: 1.06rem;
  line-height: 1.7;
  max-width: maxWidth;
}
.note-body > *:first-child { margin-top: 0; }
.note-body > *:last-child { margin-bottom: 0; }
.note-body h1, .note-body h2, .note-body h3 {
  font-family: uiFont;
  color: textBright;
  margin: 1.2rem 0 0.4rem;
}
.note-body h1 { font-size: 1.25rem; }
.note-body h2 { font-size: 1.1rem; }
.note-body h3 { font-size: 1rem; }
.note-body blockquote {
  margin: 0.8rem 0;
  padding-left: 0.9rem;
  border-left: 3px solid border;
  color: textDim;
}
.note-body code {
  font-family: monoFont;
  font-size: 0.88rem;
  background: bgSunken;
  padding: 0.05rem 0.3rem;
  border-radius: 3px;
}
.note-body pre {
  background: bgSunken;
  padding: 0.7rem 0.9rem;
  border-radius: radius;
  overflow-x: auto;
}
.note-body pre code { background: none; padding: 0; }
// Strong's shortcodes render as ordinary lexicon links; targeting the href is
// what lets them be styled without the Markdown renderer emitting a class.
.note-body a[href*="/lexicon/"] {
  font-family: monoFont;
  font-size: 0.85rem;
  color: accentWarm;
  border-bottom: 1px dotted accentWarm;
}
.note-body a[href*="/lexicon/"]:hover { text-decoration: none; }

// ---- note editor ---------------------------------------------------------
.note-editor { max-width: 46rem; }

.field { display: block; margin-bottom: 1rem; }
.field-label {
  display: block;
  font-size: 0.82rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: textDim;
  margin-bottom: 0.25rem;
}
.field input[type=text], .field textarea { width: 100%; }
.field textarea {
  font-family: monoFont;
  font-size: 0.92rem;
  line-height: 1.6;
  resize: vertical;
}
.field-hint { display: block; margin-top: 0.25rem; font-size: 0.8rem; color: textDim; }

// A horizontal cluster of controls ending in a submit — the quick-add forms.
.field-row {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  margin-top: 0.5rem;
}
.field-row input[type=text] { flex: 1 1 12rem; }

// ---- disclosures ---------------------------------------------------------
// Quick-add, inline edit and delete all hide behind a <details>, which needs
// no JavaScript and gives keyboard access for free.
.quick-add, .inline-edit, .danger-zone { margin-top: 0.8rem; }
.quick-add summary, .inline-edit summary, .danger-zone summary {
  cursor: pointer;
  font-size: 0.88rem;
  color: textDim;
  padding: 0.25rem 0;
}
.quick-add summary:hover, .inline-edit summary:hover { color: accent; }
.quick-add textarea {
  width: 100%;
  font-family: monoFont;
  font-size: 0.92rem;
  resize: vertical;
  margin-top: 0.4rem;
}
.inline-edit form { display: flex; gap: 0.4rem; margin-top: 0.4rem; }
.inline-edit input[type=text] { flex: 1 1 20rem; }

.danger-zone { border-top: 1px solid border; padding-top: 0.6rem; }
.danger-zone summary:hover { color: danger; }
.danger-zone .page-sub { margin: 0.4rem 0 0.6rem; }

// ---- scripture inside a note ---------------------------------------------
.anchor { padding: 0.5rem 0; border-bottom: 1px solid border; }
.anchor:last-child { border-bottom: none; padding-bottom: 0; }
.anchor-ref {
  display: block;
  font-size: 0.8rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 0.3rem;
}
.anchor-text {
  font-family: readFont;
  font-size: 1.05rem;
  line-height: 1.65;
  color: textBright;
  max-width: maxWidth;
}
.verse-inline + .verse-inline { margin-left: 0.3rem; }

// ---- cross-references ----------------------------------------------------
.xref-group { margin-bottom: 0.7rem; }
.xref-heading {
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: textDim;
  font-weight: 600;
  margin: 0.4rem 0 0.3rem;
}
.xref-row {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  padding: 0.25rem 0;
}
.xref-arrow { color: textDim; font-size: 0.9rem; }
.xref-ref { font-weight: 600; }
.xref-comment { color: textDim; font-size: 0.88rem; }
.xref-delete { margin-left: auto; }

// ---- misc ----------------------------------------------------------------
.kv { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem; font-size: 0.92rem; }
.kv dt { color: textDim; }
.kv dd { margin: 0; font-family: monoFont; font-size: 0.85rem; word-break: break-all; }

.site-footer {
  max-width: 60rem;
  margin: 0 auto;
  padding: 1rem;
  color: textDim;
  font-size: 0.82rem;
  border-top: 1px solid border;
}

@media (max-width: 600px) {
  .header-search { margin-left: 0; width: 100%; }
  .header-search input { width: 100%; max-width: none; }
  .scripture { font-size: 1.1rem; }
}
